{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python -m backend.scripts.check_deployment",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,backend/tests/**,backend/scripts/train_models.py,backend/ml/evaluate.py,docs/**,data/raw/**,data/processed/**,models/ppr-v1/*_ridge.joblib,reports/ml/*.png,reports/ml/*_example_features.json,.venv*/**,.python/**,.cache/**,.pytest_cache/**,.matplotlib/**,.git/**,.agents/**,.codex/**,.aws/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
