{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python -m backend.scripts.check_deployment",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,backend/tests/**,docs/**,data/{raw,processed}/**,models/**/*_ridge.joblib,reports/**/*.png,.venv*/**,.python/**,.cache/**,.pytest_cache/**,.matplotlib/**,.git/**,.agents/**,.codex/**,.aws/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
